{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "gamaresik",
          "appId": "1:598848553918:android:41d9be975561eaadcdefef",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "gamaresik",
          "appId": "1:598848553918:ios:ecda1b1524a43c90cdefef",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "gamaresik",
          "configurations": {
            "android": "1:598848553918:android:41d9be975561eaadcdefef",
            "ios": "1:598848553918:ios:ecda1b1524a43c90cdefef"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "gamaresik",
    "public": "anotasi/publik",
    "cleanUrls": true,
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/*firebase-adminsdk*.json",
      "**/*.env*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions-anotasi",
      "codebase": "anotasi",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ]
}
