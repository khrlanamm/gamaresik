rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Scan photos, one folder per user. The classifyWaste Cloud Function
    // reads these via the Admin SDK (bypasses these rules); clients may only
    // read/write inside their own folder.
    match /scans/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Salinan kecil citra penelitian untuk studi anotasi ulang. Hanya terbaca
    // oleh pemegang kode anotator; peneliti sengaja tidak diberi klaim itu,
    // sehingga halaman pemantauannya tidak mungkin menampilkan citra yang
    // sedang dinilai. Unggahan dikerjakan Admin SDK yang melewati aturan ini.
    match /anotasi/citra/{berkas} {
      allow read: if request.auth != null && request.auth.token.anotator == true;
      allow write, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
